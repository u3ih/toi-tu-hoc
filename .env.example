# Copy to .env.local for local development:
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Every var here is NEXT_PUBLIC_*, so its value is
# baked into the client bundle at build time and is public — never put a secret
# in this file. Changing one requires a rebuild, not just a restart.
#
# All three are optional and all three are commented out, which is what you
# want for `pnpm dev`. Uncomment a line to override the default. Note that an
# empty assignment is not the same as a missing one: `FOO=` sets FOO to the
# empty string, so comment the line out rather than blanking its value.


# Google Tag Manager container id. Unset, no tag ships at all — no script tag,
# no dataLayer, no third-party request. Set it only when you actually want to
# test tag firing locally; production gets it from the Vercel project's
# environment variables.
#
# Must match GTM-XXXXXXX or the build fails loudly (see lib/gtm.ts).
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Public origin, used for canonical URLs, hreflang, sitemap and JSON-LD.
# No trailing slash (one is stripped anyway). Defaults to http://localhost:3000.
#
# Set this to the real domain in production, otherwise every canonical URL and
# sitemap entry points at localhost.
# NEXT_PUBLIC_SITE_URL=https://u3ih.io.vn

# Path prefix for the whole site, for hosts that serve it from a subdirectory
# (GitHub Pages project sites are /<repo>). Leading slash, no trailing slash.
# Leave unset on Vercel, which serves from the domain root.
# NEXT_PUBLIC_BASE_PATH=/toi-tu-hoc

# Vercel Web Analytics needs no configuration: the script is served from the
# deployment's own origin. Enable it in the Vercel dashboard, under Analytics.
